# Clerk (dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase Postgres (Project -> Connect)
# Runtime: TRANSACTION pooler, port 6543 (used by src/db/index.ts with prepare:false)
DATABASE_URL=postgres://postgres.[ref]:[PASSWORD]@aws-[region].pooler.supabase.com:6543/postgres
# Migrations: DIRECT or SESSION pooler, port 5432 (used by drizzle.config.ts)
DATABASE_URL_DIRECT=postgres://postgres.[ref]:[PASSWORD]@aws-[region].pooler.supabase.com:5432/postgres

# wger exercise API (optional — defaults to the public instance, no API key required)
# Override only to point at a self-hosted wger. Used by src/lib/wger.ts.
WGER_API_BASE_URL=https://wger.de/api/v2
# wger API key (optional — needed ONLY for the /programs/templates browse+import
# surface: wger's routine endpoints require token auth even for PUBLIC templates,
# unlike its exercise catalog). Any free wger.de account's key works
# (wger.de -> settings -> API). Unset = templates page shows a "not configured"
# empty state; exercise search is unaffected. Used by src/lib/wger-templates.ts.
WGER_API_KEY=

# Upstash Redis (optional — caches the wger exercise catalog for fast search).
# console.upstash.com -> your database -> REST API. Used by src/lib/redis.ts.
# When unset, the app falls back to fetching the catalog directly from wger.
UPSTASH_REDIS_REST_URL=https://[name].upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Web-push VAPID keys (generate once: npx web-push generate-vapid-keys).
# Public key ships twice: NEXT_PUBLIC_* for the client-side
# pushManager.subscribe call, plain VAPID_PUBLIC_KEY for the server sender —
# both must hold the SAME value. Subject is a mailto/URL per RFC 8292.
# Used by src/lib/push.ts and the settings "Workout reminders" toggle.
VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=xxx
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...

# Shared secret for Vercel cron requests (any long random string). Vercel
# sends it as `Authorization: Bearer ...` automatically when the env var
# exists. Used by src/app/api/cron/reminders/route.ts; unset = cron rejects.
CRON_SECRET=xxx

# Target userId for unauthenticated MCP tool calls (POC). When set, MCP tools
# (e.g. "add my workout") need no userId argument. Use a real Clerk user id.
MCP_DEV_USER_ID=

# Coach dev gate — comma-separated Clerk user ids allowed to use the coach.
# Absent, falls back to MCP_DEV_USER_ID; nothing configured = nobody.
COACH_ALLOWED_USER_IDS=
# AI coach (/api/chat) — provider-agnostic; see src/lib/coach/model.ts.
# Configure EITHER (or both — OpenRouter wins when both are set):
# OpenRouter (prepaid credits): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Vercel AI Gateway. On Vercel, OIDC covers auth and the key is optional;
# elsewhere it is required. https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
# Optional: force one provider when several are configured
# ('openrouter' | 'vercel-gateway').
COACH_PROVIDER=
# Optional model override (vendor/model slug, same format on both providers).
# Defaults to anthropic/claude-sonnet-4.5.
COACH_MODEL=

# Sentry error monitoring (optional — a sentry.io project DSN, free tier).
# Absent = the SDK is never loaded anywhere; zero overhead. The client needs
# the NEXT_PUBLIC_ copy (baked in at build time); server/edge read SENTRY_DSN
# and fall back to the public one. Used by src/instrumentation.ts,
# src/instrumentation-client.ts, src/app/global-error.tsx.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Cron dead-man heartbeat (optional — e.g. a healthchecks.io ping URL).
# GET-pinged after each fully-successful /api/cron/reminders run; absent =
# skipped, ping failures never fail the cron.
HEALTHCHECK_PING_URL=

# Langfuse LLM tracing for the AI coach (optional — cloud.langfuse.com keys).
# Both keys absent = no exporter registered and telemetry stays off; zero
# overhead. Used by src/instrumentation.ts and src/lib/coach/telemetry.ts.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional self-host/region override; defaults to https://cloud.langfuse.com
LANGFUSE_BASEURL=

# --- Internal ops dashboard (/ops) -------------------------------------------
# Allowlist of Clerk user ids (comma-separated) who may reach /ops. Absent,
# falls back to MCP_DEV_USER_ID; nothing configured = nobody (fail closed).
# The route 404s for everyone off the list. Used by src/lib/ops/access.ts.
OPS_ALLOWED_USER_IDS=

# Sentry read API — powers the /ops Sentry card (unresolved issues, 24h). This
# is a personal API AUTH TOKEN (not the DSN above): sentry.io -> Settings ->
# Account -> Auth Tokens (scope: project:read). Org/project are the URL slugs.
# All three absent = the card shows "not configured". Used by src/lib/ops/sentry.ts.
SENTRY_API_TOKEN=
SENTRY_ORG_SLUG=david-1k
SENTRY_PROJECT_SLUG=poc-workout-tracker

# Healthchecks.io read API — powers the /ops Healthchecks card (cron liveness).
# healthchecks.io -> Project -> Settings -> API Access -> "API key" (read-only
# is enough). Absent = card shows "not configured". Used by src/lib/ops/healthchecks.ts.
HEALTHCHECKS_API_KEY=

# Vercel read API — powers the /ops Vercel card (latest production deploys).
# Token: vercel.com -> Account Settings -> Tokens. Project id: Project ->
# Settings -> General ("Project ID", prj_...). VERCEL_TEAM_ID (team_...) is
# only needed for team-scoped projects. Absent = "not configured".
# Used by src/lib/ops/vercel.ts.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# The /ops Langfuse card reuses the LANGFUSE_* keys above (basic auth) against
# the daily-metrics API — already set, so that card works today.
